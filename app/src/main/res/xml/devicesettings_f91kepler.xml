<?xml version="1.0" encoding="utf-8"?>
<androidx.preference.PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Present on every firmware. Version-dependent settings live in the
         devicesettings_f91kepler_*.xml siblings, included per firmware by the
         coordinator. The former DST switch is gone: the time zone the app sends
         already includes summer time, so the flag only ever double-shifted the
         clock. -->
    <SwitchPreferenceCompat
        android:defaultValue="true"
        android:key="f91_notification_popup"
        android:summary="@string/f91_pref_summary_notification_popup"
        android:title="@string/f91_pref_title_notification_popup" />

</androidx.preference.PreferenceScreen>
