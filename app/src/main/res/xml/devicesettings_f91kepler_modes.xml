<?xml version="1.0" encoding="utf-8"?>
<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The watch's mode cycle (UI Config F2F1). Only included by
         F91KeplerCoordinator when the watch's firmware is 2.16.0 or newer (or
         unknown) (see F91KeplerFirmware). One list: tick the modes, drag them
         into order (F91KeplerModes). Two copies, shown one at a time by
         F91KeplerSettingsCustomizer: the nine 3.0 modes, or all thirteen on a
         watch known to run 3.1. Seeded before inflation by
         F91KeplerModes.migrate, so the defaults below never overwrite an
         existing order. -->
    <PreferenceCategory
        android:key="f91_pref_category_modes"
        android:title="@string/f91_pref_header_modes">
        <com.mobeta.android.dslv.DragSortListPreference
            android:defaultValue="@array/f91_modes_default"
            android:dialogTitle="@string/f91_pref_title_modes"
            android:entries="@array/f91_modes_entries"
            android:entryValues="@array/f91_modes_values"
            android:key="f91_modes"
            android:persistent="true"
            android:summary="@string/f91_pref_summary_modes"
            android:title="@string/f91_pref_title_modes" />
        <com.mobeta.android.dslv.DragSortListPreference
            android:defaultValue="@array/f91_modes_default"
            android:dialogTitle="@string/f91_pref_title_modes"
            android:entries="@array/f91_modes31_entries"
            android:entryValues="@array/f91_modes31_values"
            android:key="f91_modes_31"
            android:persistent="true"
            android:summary="@string/f91_pref_summary_modes_31"
            android:title="@string/f91_pref_title_modes" />
    </PreferenceCategory>
</androidx.preference.PreferenceScreen>
